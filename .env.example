AMAZON_ORDER_ID=
AMAZON_ORDER_ASIN=
# Optional: use a URL to the exact order tracker/details page on amazon.com.br.
# AMAZON_ORDER_URL=https://www.amazon.com.br/progress-tracker/package?itemId=...&orderId=...
CHECK_INTERVAL_MINUTES=10
DB_PATH=./data/watcher.sqlite
AMAZON_PROFILE_DIR=./data/amazon-profile
# Optional ADB forwarding for the A30 Baileys bridge over USB.
ADB_EXECUTABLE=
ADB_SERIAL=
ADB_FORWARD_PORT=18761
# When configured, notifications use the A30 Baileys bridge.
# TAILSCALE_NOTIFY_URL=http://127.0.0.1:18761/send
# TAILSCALE_TOKEN=replace-with-a-random-secret-of-at-least-24-characters
